* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  color: #222;
  line-height: 1.6;
}

.container {
  width: 90%;
  max-width: 1100px;
  margin: 0 auto;
}


header {
  padding: 20px 0;
  border-bottom: 1px solid #ddd;
}

.header-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  border: 1px solid #ccc;
  padding: 8px 20px;
  font-weight: bold;
  color: #333;
  transition: all 0.2s ease;
  cursor: pointer;

}

.logo:hover {
  background: #333;
  color: #fff;
  transform: translateY(-3px);
}

nav {
  display: flex;
  gap: 30px;
}

nav a {
  text-decoration: none;
  color: #222;
}

nav a:hover {
  text-decoration: underline;
}


.hero {
  text-align: center;
  padding: 60px 20px;
  background: #fafafa;
  border: 1px solid #ddd;
  margin: 30px auto;
}

.hero h1 {
  font-size: 36px;
  margin-bottom: 10px;
}

.hero {
  position: relative;
  padding-bottom: 56.25%; /* 16:9 aspect ratio */
  height: 0;
  overflow: hidden;
}

.hero iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}


.about {
  display: flex;
  gap: 50px;
  align-items: flex-start;
  padding: 50px 0;
  border-top: 1px solid #ddd;
}

.about-text {
  flex: 2;
}

.about-text h2, .about-text h4 {
  margin-bottom: 15px;
}

.interests {
  list-style: none;
  padding: 0;
}

.interests li {
  padding: 8px 12px;
  margin-bottom: 6px;
  border-radius: 6px;
  background: #f5f5f5;
  transition: all 0.2s ease;
  cursor: pointer;
}

.interests li:hover {
  background: #2563eb;
  color: #fff;
  transform: translateX(5px);
}

.about-image img {
  width: 200px;
  height: 200px;
  border-radius: 50%;
  object-fit: cover;
}

/* Contact Form */
.contact {
  padding: 50px 0;
}

.contact h2 {
  margin-bottom: 10px;
}

form {
  margin-top: 30px;
  max-width: 600px;
}

.form-group {
  margin-bottom: 20px;
}

label {
  display: block;
  margin-bottom: 5px;
  font-weight: 600;
}

input, textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-family: inherit;
  font-size: 15px;
}

input:focus, textarea:focus {
  outline: none;
  border-color: #2563eb;
  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
}

.error {
  color: #dc2626;
  font-size: 13px;
  display: block;
  margin-top: 5px;
}

.btn {
  display: inline-block;
  padding: 12px 24px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 600;
  font-size: 15px;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-primary {
  background: #2563eb;
  color: #fff;
}

.btn-primary:hover {
  background: #1d4ed8;
}

.form-message {
  margin-top: 15px;
  padding: 12px;
  border-radius: 6px;
  display: none;
}

.form-message.success {
  background: #dcfce7;
  color: #166534;
  display: block;
}

.form-message.error {
  background: #fee2e2;
  color: #991b1b;
  display: block;
}

/* Footer */
footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  align-items: center;
  padding: 40px 0;
  background-color: #fafafa43;
  
}
.footer.bacckground {
  background-color: #fafafa28;
}
.footer-map{
    margin-left: auto;

}
.map-placeholder {
  width: 300px;
  height: 200px;
  background: #eee;
  display: flex;
  align-items: center;
  justify-content: center;
 
}
 .footer-map, .map-placeholder {
margin-right: 40px;
}

.socials {
  display: flex;
  gap: 15px;
  margin-top: 15px;
}

.socials a {
  width: 38px;
  height: 38px;
  border: 1px solid #333;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  color: #333;
  cursor: pointer;
  transition: all 0.2s ease;
}
.socials a:hover {
  background: #333;
  color: #fff;
  transform: translateY(-3px);
}
.center {
  text-align: center;
  margin-top: 15px; 
  justify-content: center;
  transition: all 0.2s ease;

}
a {
 
   text-align: center;
   display: flex;
   gap: 20px;
   justify-content: center;
   margin-top: 15px;
   padding: 8px 12px;
   border-radius: 6px;
   transition: all 0.2s ease;
}
a:hover {
  text-decoration: none;
  background: #333;
  color: #fff;
  cursor: pointer;
   border: 1px solid;
  border-radius: 6px;
  transform: translateY(-3px);
}






/* Responsive */
@media (max-width: 768px) {
  .about, .header-wrap {
    flex-direction: column;
    text-align: center;
  }

}
nav {
  display: flex;
  gap: 30px;
  justify-content: center;
}
